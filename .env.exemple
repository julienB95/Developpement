# Copier ce fichier en .env et renseigner les valeurs reelles.
# .env n'est jamais versionne.

# --- PostgreSQL heberge sur le NAS Synology ---
PGHOST=192.168.1.10
PGPORT=5433
PGDATABASE=crypto
PGUSER=admin
PGPASSWORD=a_remplacer
# true uniquement si le conteneur PostgreSQL est configure en TLS
PGSSL=false
PGPOOL_MAX=10

# --- API crypto ---
CRYPTO_API_HOST=127.0.0.1
CRYPTO_API_PORT=9998

# --- Connexion Google (OpenID Connect) ---
# Identifiant client OAuth cree sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=
# Duree de validite d'une session, en jours
SESSION_DUREE_JOURS=30

# --- Sources externes ---
# Identifiants CoinGecko des actifs suivis, separes par des virgules.
# Vide = liste par defaut (bitcoin, ethereum, solana, ripple, cardano, binancecoin, dogecoin, chainlink)
CRYPTO_ACTIFS_SUIVIS=

# --- Envoi de courriel (reinitialisation de mot de passe) ---
# Sans ces reglages, la demande de reinitialisation repond normalement
# mais aucun courriel ne part : l'echec est seulement journalise.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=

# Adresse publique du site, utilisee dans le lien de reinitialisation.
# Sans elle, l'en-tete Host de la requete est utilise.
SITE_URL=
