# Copier ce fichier en .env et renseigner les valeurs reelles.
# .env n'est jamais versionne.

# --- PostgreSQL heberge sur le NAS Synology ---
PGHOST=192.168.1.10
PGPORT=5433
PGDATABASE=crypto
PGUSER=admin
PGPASSWORD=a_remplacer
# true uniquement si le conteneur PostgreSQL est configure en TLS
PGSSL=false
PGPOOL_MAX=10

# --- API crypto ---
CRYPTO_API_HOST=127.0.0.1
CRYPTO_API_PORT=9998

# --- Connexion Google (OpenID Connect) ---
# Identifiant client OAuth cree sur https://console.cloud.google.com
GOOGLE_CLIENT_ID=
# Duree de validite d'une session, en jours
SESSION_DUREE_JOURS=30

# --- Sources externes ---
# Identifiants CoinGecko des actifs suivis, separes par des virgules.
# Vide = liste par defaut (bitcoin, ethereum, solana, ripple, cardano, binancecoin, dogecoin, chainlink)
CRYPTO_ACTIFS_SUIVIS=

# --- Envoi de courriel (reinitialisation de mot de passe) ---
# Sans ces reglages, la demande de reinitialisation repond normalement
# mais aucun courriel ne part : l'echec est seulement journalise.
SMTP_HOTE=
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOTDEPASSE=
SMTP_EXPEDITEUR=

# --- Sauvegardes ---
# Dossier racine des sauvegardes, hors du depot : un sous-dossier horodate y est
# cree a chaque sauvegarde, avec source/, bdd/ et l'archive envoyee par courriel.
# Vide = dossier Sauvegarde a cote du depot (C:\Git\Sauvegarde sur le poste).
# Dans le conteneur, c'est le volume monte : voir application/crypto/docker-compose.yml.
SAUVEGARDE_CHEMIN=
# Destinataire de l'archive. Vide = julien@boesel.fr
SAUVEGARDE_COURRIEL=
# Au-dela de cette taille, le courriel part sans la piece jointe : la sauvegarde
# reste alors disponible dans son dossier. En megaoctets, defaut 15.
SAUVEGARDE_TAILLE_COURRIEL_MO=15

# Adresse publique du site, utilisee dans le lien de reinitialisation.
# Sans elle, l'en-tete Host de la requete est utilise.
SITE_URL=

# --- Deploiement sur le NAS (utilise par la commande /deploy) ---
# Ces valeurs ne servent qu'au poste de developpement : le NAS n'en a pas besoin.
NAS_HOTE=192.168.1.10
NAS_UTILISATEUR=julien
NAS_PORT_SSH=22
# Emplacement du clone du depot dans le dossier d'equipe SITES
NAS_CHEMIN=/volume1/SITES/crypto
