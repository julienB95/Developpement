# Copier ce fichier en .env et renseigner les valeurs reelles.
# .env n'est jamais versionne.

# --- PostgreSQL heberge sur le NAS Synology ---
PGHOST=192.168.1.10
PGPORT=5433
PGDATABASE=crypto
PGUSER=admin
PGPASSWORD=a_remplacer
# true uniquement si le conteneur PostgreSQL est configure en TLS
PGSSL=false
PGPOOL_MAX=10

# --- API crypto ---
CRYPTO_API_HOST=127.0.0.1
CRYPTO_API_PORT=9998
